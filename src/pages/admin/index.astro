---
import Admin from '@/layouts/Admin.astro';
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';
import { UserManager } from '@/components/admin/UserManager';
import { getKv } from '@/lib/kv';

const user = Astro.locals.user!;
const kv = getKv(Astro.locals);
const users = kv ? await kv.listUsers() : [];
---

<Admin
  title="Medlemmar"
  description="Hantera vilka e-postadresser som kan logga in på medlemssidan."
>
  <section class="admin-page">
    <Container>
      <header class="admin-page__head">
        <p class="kicker">ADMIN</p>
        <h1>Hantera medlemmar</h1>
        <p class="lede">
          Lägg till e-postadresser för boende som ska få tillgång till
          medlemssidan. Endast dessa adresser kan begära en inloggningslänk.
          Ändringar sparas direkt och påverkar pågående sessioner vid nästa anrop.
        </p>
      </header>

      <Card surface="surface" bordered padding="6">
        <UserManager client:load initialUsers={users} currentUserEmail={user.email} />
      </Card>

      <Card surface="alt" bordered padding="6">
        <h2 style="margin: 0 0 var(--space-3); font-size: var(--text-lg)">Hur inloggning fungerar</h2>
        <ul style="margin: 0; padding-left: var(--space-5); line-height: var(--leading-relaxed)">
          <li>Boende anger sin e-post på <code>/medlem/logga-in</code></li>
          <li>Om adressen finns i listan skickas en inloggningslänk (giltig 15 minuter)</li>
          <li>Klick på länken loggar in användaren i <strong>180 dagar</strong></li>
          <li>Sessionen förnyas automatiskt vid varje besök — aktiva användare loggas sällan ut</li>
          <li>Ta bort en adress här för att omedelbart blockera framtida inloggningar</li>
        </ul>
      </Card>
    </Container>
  </section>
</Admin>

<style>
  .admin-page {
    padding: var(--space-10) 0 var(--space-12);
  }

  .admin-page__head {
    margin-bottom: var(--space-8);
    max-width: 70ch;
  }

  .admin-page h1 {
    margin-top: var(--space-4);
  }

  .admin-page .lede {
    margin: var(--space-4) 0 0;
  }

  .admin-page :global(.card) + :global(.card) {
    margin-top: var(--space-6);
  }
</style>
