---
export const prerender = true;

import Public from '@/layouts/Public.astro';
import Hero from '@/components/sections/Hero.astro';
import StatsBand from '@/components/sections/StatsBand.astro';
import ImageStory from '@/components/sections/ImageStory.astro';
import FeatureTiles from '@/components/sections/FeatureTiles.astro';
import QuoteSection from '@/components/sections/QuoteSection.astro';
import MemberCTA from '@/components/sections/MemberCTA.astro';

const stats = [
  { value: '47', label: 'Hushåll' },
  { value: '400', unit: 'm', label: 'Till station' },
  { value: '5', unit: 'min', label: 'Till havet' },
  { value: '50', unit: 'år', label: 'Av gemenskap' },
];

const tiles = [
  {
    number: '01',
    kicker: 'Bostad',
    title: 'Kvartersstuga',
    text: 'Festlokal med kök, soffgrupp och fyra sovplatser. Boka för 150 kr/dygn.',
    href: '/vad-ingar/kvartersstugan',
    image: '/images/placeholders/asa-neighborhood-1.jpg',
    imageAlt: '',
  },
  {
    number: '02',
    kicker: 'Bostad',
    title: 'Garage & parkering',
    text: 'Numrerad plats per hushåll, elbilsladdare installerad 2024.',
    href: '/vad-ingar/garage-parkering',
    image: '/images/placeholders/asa-station.jpg',
    imageAlt: '',
  },
  {
    number: '03',
    kicker: 'Resurser',
    title: 'Verktyg & utrustning',
    text: 'Gräsklippare, trimmer, snöblad och stegar att låna.',
    href: '/vad-ingar/verktyg',
    image: '/images/placeholders/asa-neighborhood-2.jpg',
    imageAlt: '',
  },
  {
    number: '04',
    kicker: 'Utomhus',
    title: 'Grönytor & lekplats',
    text: 'Gemensamma ytor vi sköter själva på två årliga arbetsdagar.',
    href: '/vad-ingar/gronytor-lekplats',
    image: '/images/placeholders/brataviken.jpg',
    imageAlt: '',
  },
];
---

<Public
  title="Bäckvägens Samfällighetsförening"
  description="47 hushåll i Åsa, Kungsbacka — en välskött samfällighet sedan 1976 mellan havet och järnvägsstationen."
>
  <Hero
    kicker="SAMFÄLLIGHETSFÖRENING · SEDAN 1976"
    headline="Där havet möter"
    headlineAccent="vardagen."
    lede="47 hem i ett välskött kvarter mellan Åsa station och Västkusten. Ett av Kungsbackas lugnare grannskap — och vi sköter det själva."
    primaryCta={{ label: 'Utforska området', href: '/omradet' }}
    secondaryCta={{ label: 'Avgifter & fakta', href: '/avgifter' }}
    backgroundImage="/images/placeholders/asa-sunset.jpg"
    backgroundImageAlt=""
  />

  <StatsBand stats={stats} />

  <ImageStory
    kicker="KVARTERSSTUGAN"
    title="Ett hem utöver ditt eget."
    text="Festlokal med kök, soffgrupp, matbord för åtta och fyra sovplatser. Boka stugan för 150 kr/dygn — för bröllopsfester, barnkalas eller sovmorgonbesök."
    linkLabel="Läs om kvartersstugan"
    linkHref="/vad-ingar/kvartersstugan"
    image="/images/placeholders/asa-south-view.jpg"
    imageAlt="Bostadsområde i Åsa med havet i bakgrunden"
    imageCaption="Tillfälligt områdesfoto från Åsa"
  />

  <FeatureTiles
    kicker="VAD INGÅR I OMRÅDET"
    title="Det ni köper med tomten."
    lede="Mer än bara ett hus — en andel i ett grannskap vi byggt tillsammans sedan 1976."
    tiles={tiles}
  />

  <QuoteSection
    label="FRÅN STYRELSEN"
    quote="Tillsammans är vi 47 hushåll som strävar för att bo i ett trivsamt, välskött och tryggt område."
    attribution="Bäckvägens Samfällighetsförening"
  />

  <MemberCTA
    title="Bor du redan här?"
    description="Logga in för frågor & svar, styrelsens kontaktuppgifter och alla viktiga dokument."
    buttonLabel="Logga in som boende"
    buttonHref="/medlem/logga-in"
  />
</Public>
