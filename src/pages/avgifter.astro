---
export const prerender = true;

import ContentPage from '@/layouts/ContentPage.astro';
import Card from '@/components/ui/Card.astro';

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'Avgifter' },
];
---

<ContentPage
  title="Avgifter"
  lede="Samtliga 47 andelar (hushåll) betalar månadsvis en samfällighetsavgift som beslutas vid årsstämman. Dessutom faktureras en årlig vägavgift separat."
  kicker="EKONOMI & AVGIFTER"
  breadcrumbs={breadcrumbs}
  sidebar={true}
>
  <h2>Samfällighetsavgift</h2>
  <p>
    Samtliga 47 andelar (hushåll) betalar månadsvis en obligatorisk
    samfällighetsavgift. Avgiften beslutas vid årsstämman och skall täcka
    löpande drift samt förnyelse/underhåll. Avgiften är <strong>1 760 kr/månad</strong>
    till dess att annat beslut fattas vid årsstämman.
  </p>
  <p>Driftskostnader inkluderar bland annat:</p>
  <ul>
    <li>Vatten</li>
    <li>Sophämtning</li>
    <li>Elförbrukning för garage</li>
    <li>Gräsklippning</li>
    <li>Räntekostnader</li>
    <li>Försäkringar</li>
    <li>Tele2 kabel-TV</li>
  </ul>
  <p>
    Avsättning görs årligen till en underhålls- och förnyelsefond för
    anläggningens framtida underhåll enligt plan.
  </p>

  <h2>Vägavgift</h2>
  <p>
    Varje fastighetsägare betalar årsvis en vägavgift till Åsa
    Samfällighetsförening. Avgiften är för närvarande <strong>1 500 kr</strong> och
    faktureras separat till respektive hushåll.
  </p>

  <h2>Avgiftsinbetalning</h2>
  <p>
    Samfällighetsavgiften skall betalas i förskott. Fakturor (med OCR-nummer)
    skickas ut för 6 månader i taget i förväg så man bara behöver lägga in
    betalning 2 gånger per år.
  </p>
  <p>
    Fakturan skickas i första hand via e-post. Om du inte har angivit någon
    e-postadress skickas fakturan istället i pappersformat till din
    folkbokföringsadress.
  </p>
  <p>
    Vid betalning, använd alltid det angivna OCR-numret för att din inbetalning
    ska kunna registreras korrekt.
  </p>

  <Card slot="sidebar" surface="alt" bordered padding="5">
    <p style="margin-bottom: var(--space-3); font-size: var(--text-xs); letter-spacing: 0.15em; color: var(--color-primary); font-weight: 700; text-transform: uppercase;">Aktuella avgifter</p>
    <dl style="margin: 0; font-size: var(--text-sm); display: grid; gap: var(--space-4);">
      <div>
        <dt style="color: var(--color-text-muted); margin-bottom: var(--space-1);">Samfällighetsavgift</dt>
        <dd style="margin: 0; font-weight: 900; color: var(--color-primary); font-size: var(--text-xl); letter-spacing: -0.01em;">1 760 kr<span style="font-size: var(--text-xs); font-weight: 600;"> / månad</span></dd>
      </div>
      <div>
        <dt style="color: var(--color-text-muted); margin-bottom: var(--space-1);">Vägavgift</dt>
        <dd style="margin: 0; font-weight: 900; color: var(--color-primary); font-size: var(--text-xl); letter-spacing: -0.01em;">1 500 kr<span style="font-size: var(--text-xs); font-weight: 600;"> / år</span></dd>
      </div>
    </dl>
  </Card>

  <Card slot="sidebar" surface="alt" bordered padding="5">
    <p style="margin-bottom: var(--space-3); font-size: var(--text-xs); letter-spacing: 0.15em; color: var(--color-primary); font-weight: 700; text-transform: uppercase;">Frågor om fakturor?</p>
    <p style="font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-3);">
      Kontakta styrelsen om du saknar faktura eller behöver ändra betalningsuppgifter:
    </p>
    <p style="margin: 0;">
      <a href="mailto:kassor@asabackvag.se" style="font-weight: 700;">kassor@asabackvag.se</a>
    </p>
  </Card>
</ContentPage>
