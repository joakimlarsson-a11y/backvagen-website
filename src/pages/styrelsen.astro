---
import Public from '@/layouts/Public.astro';
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';
import { getCollection } from 'astro:content';

const board = (await getCollection('styrelsen')).sort((a, b) => a.data.order - b.data.order);

const boardDuties = [
  'Förvalta föreningens tillgångar',
  'Föra redovisning över föreningens räkenskaper',
  'Sammankalla till ordinarie föreningsstämma',
  'Sammankalla till extra föreningsstämma (vid behov)',
  'Avge förvaltningsberättelse över föreningens verksamhet och ekonomi till ordinarie föreningsstämma',
  'Hålla förvaltningsberättelse, revisionsberättelse och förslag till inkomst- och utgiftsstat tillgängliga, inför ordinarie föreningsstämma',
  'Hålla underhålls- och förnyelseplan tillgänglig, inför ordinarie föreningsstämma',
];
---

<Public
  title="Styrelsen"
  description="Kontaktuppgifter till styrelsen för Bäckvägens Samfällighetsförening."
>
  <section class="board">
    <Container>
      <header class="board__header">
        <p class="kicker">FÖRENINGEN</p>
        <h1>Styrelsen</h1>
        <p class="lede">
          Vid frågor eller felanmälan, använd i första hand gemensamma e-postadressen
          <a href="mailto:styrelsen@asabackvag.se">styrelsen@asabackvag.se</a>.
          Styrelsens ledamöter utses genom rullande schema vid ordinarie föreningsstämma.
        </p>
      </header>

      <ul class="board__list" role="list">
        {
          board.map(({ data: m }) => (
            <li>
              <Card surface="surface" bordered padding="5">
                <article class="board-card">
                  <div class="board-card__role">{m.role}</div>
                  <h2 class="board-card__name">{m.name}</h2>
                  <p class="board-card__house">Hus {m.house}</p>
                  <dl class="board-card__contact">
                    {m.email && (
                      <div>
                        <dt>E-post</dt>
                        <dd><a href={`mailto:${m.email}`}>{m.email}</a></dd>
                      </div>
                    )}
                    {m.phone && (
                      <div>
                        <dt>Telefon</dt>
                        <dd><a href={`tel:${m.phone.replace(/[^+\d]/g, '')}`}>{m.phone}</a></dd>
                      </div>
                    )}
                  </dl>
                </article>
              </Card>
            </li>
          ))
        }
      </ul>

      <section class="board__info">
        <Card surface="alt" bordered padding="6">
          <h2 style="margin-top:0">Styrelsens uppdrag</h2>
          <p>
            Styrelsens ledamöter utses genom rullande schema (ordförande,
            sekreterare och kassör kan väljas utanför schemat) vid ordinarie
            föreningsstämma och har i uppdrag att bland annat:
          </p>
          <ul>
            {boardDuties.map((duty) => <li>{duty}</li>)}
          </ul>
        </Card>

        <Card surface="alt" bordered padding="6">
          <h2 style="margin-top:0">Föreningsstämma (årsstämma)</h2>
          <p>
            Den ordinarie föreningsstämman utgör en viktig möjlighet att ta del av
            och påverka vad som sker inom samfällighetsföreningen. Motioner ska
            vara styrelsen tillhanda senast i januari månad. Praxis inom föreningen
            har blivit att samtliga av de begärda handlingarna, som skall hållas
            tillgängliga för medlemmarna, delas ut tillsammans med kallelsen till
            stämman.
          </p>
          <p>
            Om man inte kan delta på årsstämman kan man utse ombud att delta genom
            fullmakt. Ombud får bara företräda maximalt en medlem. Endast en person
            per hushåll har rösträtt på föreningsstämman.
          </p>
        </Card>

        <Card surface="alt" bordered padding="6">
          <h2 style="margin-top:0">Styrelsemöte</h2>
          <p>
            Styrelsen sammanträder normalt en gång i månaden, där det blivit
            praxis att mötas första söndagen i månaden kl. 18:00 och att mötet
            äger rum i Kvartersstugan. På mötet avhandlas frågor rörande
            samfällighetens ekonomi, löpande förvaltning och eventuella frågor
            från medlemmarna. Mötesprotokollet anslås på anslagstavla utanför
            Kvartersstugan.
          </p>
        </Card>
      </section>
    </Container>
  </section>
</Public>

<style>
  .board {
    padding: var(--space-10) 0 var(--space-12);
  }

  .board__header {
    margin-bottom: var(--space-8);
    max-width: 70ch;
  }

  .board h1 {
    margin-top: var(--space-4);
  }

  .board .lede {
    margin-top: var(--space-4);
  }

  .board__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .board__info {
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-4);
  }

  .board__info :global(ul) {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
    line-height: var(--leading-relaxed);
  }

  .board__info :global(li) {
    margin-bottom: var(--space-2);
  }

  .board__info :global(p) + :global(p) {
    margin-top: var(--space-3);
  }

  .board-card {
    display: grid;
    gap: var(--space-2);
  }

  .board-card__role {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary-soft);
    font-weight: 700;
  }

  .board-card__name {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-primary);
  }

  .board-card__house {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .board-card__contact {
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .board-card__contact div {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-3);
    align-items: baseline;
  }

  .board-card__contact dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .board-card__contact dd {
    margin: 0;
    font-weight: var(--weight-medium);
    word-break: break-all;
  }

  .board-card__contact a {
    color: var(--color-primary);
  }

  @media (min-width: 700px) {
    .board__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .board__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
