---
import Member from '@/layouts/Member.astro';
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';
import { getCollection } from 'astro:content';

const member = await getCollection('dokument-medlem');
const publika = await getCollection('dokument-publika');

function sort<T extends { data: { date?: string } }>(list: T[]): T[] {
  return [...list].sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
}

function formatDate(iso?: string): string {
  if (!iso) return '';
  const [y, m, d] = iso.split('-');
  return `${d}.${m}.${y}`;
}

const memberSorted = sort(member);
const publikaSorted = sort(publika);
---

<Member
  title="Dokument"
  description="Informationsbrev, mötesprotokoll och andra interna dokument."
>
  <section class="docs">
    <Container>
      <header class="docs__header">
        <p class="kicker">MEDLEMSOMRÅDE</p>
        <h1>Dokument</h1>
        <p class="lede">
          Informationsbrev, mötesprotokoll och övriga interna dokument för boende.
          Publika dokument som stadgar och anläggningsbeslut listas längre ner.
        </p>
      </header>

      <div class="docs__group">
        <h2 class="docs__group-title">Interna dokument</h2>
        {
          memberSorted.length === 0 ? (
            <p class="docs__empty">Inga dokument tillgängliga just nu.</p>
          ) : (
            <ul class="docs__list" role="list">
              {memberSorted.map((doc) => (
                <li>
                  <Card surface="surface" bordered padding="5">
                    <article class="doc">
                      <div class="doc__meta">
                        {doc.data.category && <p class="doc__category">{doc.data.category}</p>}
                        {doc.data.date && <p class="doc__date">{formatDate(doc.data.date)}</p>}
                      </div>
                      <h3 class="doc__title">{doc.data.title}</h3>
                      {doc.data.description && <p class="doc__desc">{doc.data.description}</p>}
                      {doc.data.file && (
                        <a
                          href={doc.data.file}
                          class="doc__link"
                          aria-label={`Ladda ner ${doc.data.title} (PDF)`}
                          download
                        >
                          Ladda ner PDF <span aria-hidden="true">↓</span>
                        </a>
                      )}
                    </article>
                  </Card>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="docs__group">
        <h2 class="docs__group-title">Publika dokument</h2>
        <ul class="docs__list" role="list">
          {
            publikaSorted.map((doc) => (
              <li>
                <Card surface="alt" bordered padding="5">
                  <article class="doc">
                    <div class="doc__meta">
                      {doc.data.category && <p class="doc__category">{doc.data.category}</p>}
                      {doc.data.date && <p class="doc__date">{formatDate(doc.data.date)}</p>}
                    </div>
                    <h3 class="doc__title">{doc.data.title}</h3>
                    {doc.data.description && <p class="doc__desc">{doc.data.description}</p>}
                    {doc.data.file && (
                      <a
                        href={doc.data.file}
                        class="doc__link"
                        aria-label={`Ladda ner ${doc.data.title} (PDF)`}
                        download
                      >
                        Ladda ner PDF <span aria-hidden="true">↓</span>
                      </a>
                    )}
                  </article>
                </Card>
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>
</Member>

<style>
  .docs {
    padding: var(--space-10) 0 var(--space-12);
  }

  .docs__header {
    margin-bottom: var(--space-10);
  }

  .docs__group + .docs__group {
    margin-top: var(--space-10);
  }

  .docs__group-title {
    margin: 0 0 var(--space-5);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 900;
  }

  .docs__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .docs__empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .doc {
    display: grid;
    gap: var(--space-3);
  }

  .doc__meta {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .doc__category {
    margin: 0;
    font-weight: 700;
    color: var(--color-primary);
  }

  .doc__date {
    margin: 0;
  }

  .doc__title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .doc__desc {
    margin: 0;
    color: var(--color-text);
    line-height: var(--leading-normal);
    max-width: 60ch;
  }

  .doc__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-primary);
    text-decoration: none;
    padding: var(--space-2) 0;
    align-self: start;
  }

  .doc__link:hover {
    color: var(--color-primary-hover);
    border-bottom-color: var(--color-primary-hover);
  }
</style>
