---
import Public from '@/layouts/Public.astro';
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';
import { LoginForm } from '@/components/auth/LoginForm';

// Already logged in? Send to dashboard.
if (Astro.locals.user) {
  return Astro.redirect(Astro.locals.user.role === 'admin' ? '/admin' : '/medlem');
}

const error = Astro.url.searchParams.get('error');
---

<Public
  title="Logga in"
  description="Logga in på medlemssidan för Bäckvägens Samfällighetsförening."
>
  <section class="login">
    <Container width="narrow">
      <div class="login__inner">
        <p class="kicker">MEDLEMSOMRÅDE</p>
        <h1>Logga in</h1>
        <p class="lede">
          Ange din e-postadress så skickar vi en inloggningslänk. Ingen
          lösenord — klicka bara på länken i mejlet.
        </p>

        <Card surface="surface" bordered padding="6">
          <LoginForm client:visible initialError={error} />
        </Card>

        <p class="login__help">
          Saknar du behörighet?
          <a href="/kontakt">Kontakta styrelsen</a> så lägger vi till din e-postadress.
        </p>
      </div>
    </Container>
  </section>
</Public>

<style>
  .login {
    padding: var(--space-10) 0 var(--space-12);
  }

  .login__inner {
    max-width: 560px;
    margin-inline: auto;
  }

  .login h1 {
    margin-top: var(--space-4);
  }

  .login .lede {
    margin: var(--space-4) 0 var(--space-6);
  }

  .login__help {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
