---
import Member from '@/layouts/Member.astro';
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';

const user = Astro.locals.user!;
---

<Member title="Medlemsdashboard" description="Översikt för boende i Bäckvägens Samfällighetsförening.">
  <section class="dash">
    <Container>
      <p class="kicker">MEDLEMSOMRÅDE</p>
      <h1>Välkommen tillbaka.</h1>
      <p class="lede">
        Du är inloggad som <strong>{user.email}</strong>{user.role === 'admin' ? ' (styrelse / admin)' : ''}.
        Här hittar du allt du behöver som boende i samfälligheten.
      </p>

      <ul class="dash__grid" role="list">
        <li>
          <a href="/medlem/fragor-och-svar" class="dash__card">
            <Card surface="surface" bordered padding="6">
              <p class="dash__num">01</p>
              <h2 class="dash__title">Frågor &amp; svar</h2>
              <p class="dash__text">Allt du behöver veta om sophantering, stugbokning, vatten, elbilsladdning och arbetsdagar.</p>
            </Card>
          </a>
        </li>
        <li>
          <a href="/medlem/dokument" class="dash__card">
            <Card surface="surface" bordered padding="6">
              <p class="dash__num">02</p>
              <h2 class="dash__title">Dokument</h2>
              <p class="dash__text">Informationsbrev, protokoll från stämmor och underhållsplan.</p>
            </Card>
          </a>
        </li>
        <li>
          <a href="/medlem/styrelsen" class="dash__card">
            <Card surface="surface" bordered padding="6">
              <p class="dash__num">03</p>
              <h2 class="dash__title">Styrelsen</h2>
              <p class="dash__text">Namn, husnummer, telefonnummer och e-postadresser till styrelsen.</p>
            </Card>
          </a>
        </li>
        {
          user.role === 'admin' && (
            <li>
              <a href="/admin" class="dash__card">
                <Card surface="alt" bordered padding="6">
                  <p class="dash__num dash__num--admin">04</p>
                  <h2 class="dash__title">Admin</h2>
                  <p class="dash__text">Hantera medlemmar och se inloggningslogg.</p>
                </Card>
              </a>
            </li>
          )
        }
      </ul>
    </Container>
  </section>
</Member>

<style>
  .dash {
    padding: var(--space-10) 0 var(--space-12);
  }

  .dash h1 {
    margin-top: var(--space-4);
  }

  .dash .lede {
    margin: var(--space-4) 0 var(--space-8);
  }

  .dash__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .dash__card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast);
  }

  .dash__card:focus-visible {
    outline-offset: 4px;
  }

  .dash__card:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .dash__card:hover {
      transform: none;
    }
  }

  .dash__num {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    color: var(--color-primary-soft);
    font-weight: 700;
    text-transform: uppercase;
  }

  .dash__num--admin {
    color: var(--color-primary);
  }

  .dash__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .dash__text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  @media (min-width: 700px) {
    .dash__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  @media (min-width: 1000px) {
    .dash__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
