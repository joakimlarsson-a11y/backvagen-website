---
import Public from '@/layouts/Public.astro';
import Container from '@/components/ui/Container.astro';
import Stack from '@/components/ui/Stack.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { LoginFormDemo } from '@/components/demo/LoginFormDemo';
import { DialogDemo } from '@/components/demo/DialogDemo';
---

<Public title="Komponentgalleri (demo)" description="Visuell granskning av UI-komponenterna i designsystemet.">
  <Container>
    <div class="demo">
      <header class="demo__header">
        <p class="kicker">DESIGNSYSTEM</p>
        <h1>Komponentgalleri</h1>
        <p class="lede">
          Sida för intern granskning. Här visas alla UI-komponenter i designsystemet
          så vi kan verifiera konsekvens, tillgänglighet och responsivitet innan vi
          bygger sidor ovanpå dem.
        </p>
      </header>

      <Stack gap="12">
        <!-- Typography -->
        <section aria-labelledby="sec-typo" class="demo__section">
          <h2 id="sec-typo">Typografi</h2>
          <Stack gap="3">
            <p class="kicker">En liten kicker</p>
            <p class="type-demo type-demo--h1" role="presentation">H1 — Där havet möter vardagen</p>
            <p class="type-demo type-demo--h2" role="presentation">H2 — Vad ingår i området</p>
            <p class="type-demo type-demo--h3" role="presentation">H3 — Kvartersstugan</p>
            <p class="type-demo type-demo--h4" role="presentation">H4 — Underrubrik med mindre tyngd</p>
            <p class="lede">
              Lede-stil. Används efter rubriker för sammanfattande ingresser.
            </p>
            <p>
              Brödtext i normal storlek. Vi ser till att radlängden håller sig
              kring 60–68 tecken för bästa läsbarhet, vilket sätts via
              <code>max-width: 68ch</code> på <code>&lt;p&gt;</code>-element globalt.
              <a href="#">Inbäddade länkar</a> får en subtil understrykning.
            </p>
            <p class="muted">Muted-variant för sekundär information.</p>
          </Stack>
        </section>

        <!-- Buttons -->
        <section aria-labelledby="sec-buttons" class="demo__section">
          <h2 id="sec-buttons">Knappar</h2>
          <Stack gap="4">
            <p class="muted">Varianter — primary, outline, ghost, link.</p>
            <div class="demo__row">
              <Button variant="primary">Primary</Button>
              <Button variant="outline">Outline</Button>
              <Button variant="ghost">Ghost</Button>
              <Button variant="link">Länk-stil</Button>
            </div>
            <p class="muted">Storlekar — default 44 px, lg 52 px.</p>
            <div class="demo__row">
              <Button variant="primary">Default storlek</Button>
              <Button variant="primary" size="lg">Stor storlek</Button>
            </div>
            <p class="muted">Inaktiv och som länk.</p>
            <div class="demo__row">
              <Button variant="primary" disabled>Inaktiv</Button>
              <Button variant="outline" href="/demo">Länk som knapp</Button>
            </div>
          </Stack>
        </section>

        <!-- Cards -->
        <section aria-labelledby="sec-cards" class="demo__section">
          <h2 id="sec-cards">Kort</h2>
          <div class="demo__card-grid">
            <Card surface="surface" bordered>
              <h3>Kvartersstugan</h3>
              <p>
                Festlokal med kök, soffgrupp och fyra sovplatser. Boka för 150 kr/dygn.
              </p>
            </Card>
            <Card surface="alt" bordered shadow>
              <h3>Garage</h3>
              <p>
                Numrerad garageplats per hushåll med elbilsladdare installerad 2024.
              </p>
            </Card>
            <Card surface="transparent" padding="8">
              <h3>Grönytor</h3>
              <p>
                Gemensamma grönområden och lekplats som vi sköter tillsammans på
                årliga arbetsdagar.
              </p>
            </Card>
          </div>
        </section>

        <!-- Breadcrumbs -->
        <section aria-labelledby="sec-crumbs" class="demo__section">
          <h2 id="sec-crumbs">Brödsmulor</h2>
          <Breadcrumbs
            items={[
              { label: 'Området', href: '/omradet' },
              { label: 'Vad ingår', href: '/vad-ingar' },
              { label: 'Garage & parkering' },
            ]}
          />
        </section>

        <!-- Form -->
        <section aria-labelledby="sec-form" class="demo__section">
          <h2 id="sec-form">Formulär (React Aria)</h2>
          <Card surface="surface" bordered padding="6">
            <LoginFormDemo client:visible />
          </Card>
        </section>

        <!-- Dialog -->
        <section aria-labelledby="sec-dialog" class="demo__section">
          <h2 id="sec-dialog">Dialog (React Aria)</h2>
          <p class="muted">
            Klicka knappen för att öppna. Escape, klick utanför, eller stängknappen stänger dialogen.
            Fokus fångas inuti medan dialogen är öppen och återgår till triggerknappen vid stängning.
          </p>
          <DialogDemo client:visible />
        </section>

        <!-- Colors -->
        <section aria-labelledby="sec-colors" class="demo__section">
          <h2 id="sec-colors">Färgpalett</h2>
          <div class="demo__swatches">
            <div class="swatch"><div class="swatch__color" style="background: var(--color-primary)"></div><code>--color-primary</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-primary-hover)"></div><code>--color-primary-hover</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-bg); border: 1px solid var(--color-border)"></div><code>--color-bg</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-surface); border: 1px solid var(--color-border)"></div><code>--color-surface</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-surface-alt); border: 1px solid var(--color-border)"></div><code>--color-surface-alt</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-border)"></div><code>--color-border</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-text)"></div><code>--color-text</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-text-muted)"></div><code>--color-text-muted</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-danger)"></div><code>--color-danger</code></div>
            <div class="swatch"><div class="swatch__color" style="background: var(--color-success)"></div><code>--color-success</code></div>
          </div>
        </section>
      </Stack>
    </div>
  </Container>
</Public>

<style>
  .demo {
    padding: var(--space-10) 0 var(--space-12);
  }

  .demo__header {
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .demo__header .kicker {
    margin-bottom: var(--space-3);
  }

  .demo__header .lede {
    margin-top: var(--space-4);
  }

  .demo__section {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .demo__section h2 {
    margin-bottom: var(--space-5);
  }

  .demo__row {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }

  .demo__card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 700px) {
    .demo__card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .demo__card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .demo__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .swatch {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .swatch__color {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .swatch code {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Visually match heading levels without semantic heading */
  .type-demo {
    color: var(--color-primary);
    font-weight: var(--weight-black);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-width: none;
    margin: 0;
  }
  .type-demo--h1 {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tighter);
  }
  .type-demo--h2 {
    font-size: var(--text-3xl);
  }
  .type-demo--h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
  }
  .type-demo--h4 {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }
  @media (min-width: 900px) {
    .type-demo--h1 { font-size: var(--text-5xl); }
    .type-demo--h2 { font-size: var(--text-4xl); }
    .type-demo--h3 { font-size: var(--text-2xl); }
  }
</style>
