---
interface Props {
  width?: 'default' | 'narrow';
  as?: string;
  class?: string;
}

const { width = 'default', as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class:list={['container', `container--${width}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  .container--default {
    max-width: var(--container-max);
  }

  .container--narrow {
    max-width: var(--container-narrow);
  }
</style>
