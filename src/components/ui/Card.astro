---
type Surface = 'surface' | 'alt' | 'transparent';
type Padding = '4' | '5' | '6' | '8';

interface Props {
  surface?: Surface;
  padding?: Padding;
  shadow?: boolean;
  bordered?: boolean;
  as?: string;
  class?: string;
}

const {
  surface = 'surface',
  padding = '5',
  shadow = false,
  bordered = true,
  as: Tag = 'div',
  class: className = '',
} = Astro.props;
---

<Tag
  class:list={[
    'card',
    `card--${surface}`,
    bordered && 'card--bordered',
    shadow && 'card--shadow',
    className,
  ]}
  style={`--card-padding: var(--space-${padding});`}
>
  <slot />
</Tag>

<style>
  .card {
    padding: var(--card-padding);
    border-radius: var(--radius-lg);
  }

  .card--surface {
    background: var(--color-surface);
  }

  .card--alt {
    background: var(--color-surface-alt);
  }

  .card--transparent {
    background: transparent;
  }

  .card--bordered {
    border: 1px solid var(--color-border);
  }

  .card--shadow {
    box-shadow: var(--shadow-md);
  }
</style>
