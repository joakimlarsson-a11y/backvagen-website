---
import Container from '@/components/ui/Container.astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  kicker?: string;
  headline: string;
  headlineAccent?: string;
  lede?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  backgroundImage?: string;
  backgroundImageAlt?: string;
}

const {
  kicker,
  headline,
  headlineAccent,
  lede,
  primaryCta,
  secondaryCta,
  backgroundImage,
  backgroundImageAlt,
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden={!backgroundImage || !backgroundImageAlt}>
    {
      backgroundImage ? (
        <img
          src={backgroundImage}
          alt={backgroundImageAlt ?? ''}
          class="hero__bg-image"
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="hero__bg-fallback" />
      )
    }
    <div class="hero__bg-overlay"></div>
  </div>

  <Container>
    <div class="hero__inner">
      {kicker && <p class="kicker hero__kicker">{kicker}</p>}
      <h1 id="hero-title" class="hero__headline">
        {headline}
        {
          headlineAccent && (
            <>
              <br />
              <em>{headlineAccent}</em>
            </>
          )
        }
      </h1>
      {lede && <p class="hero__lede">{lede}</p>}
      {
        (primaryCta || secondaryCta) && (
          <div class="hero__cta-row">
            {primaryCta && (
              <a href={primaryCta.href} class="hero__cta hero__cta--primary">
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a href={secondaryCta.href} class="hero__cta hero__cta--ghost">
                {secondaryCta.label}
              </a>
            )}
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-primary);
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-image,
  .hero__bg-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__bg-fallback {
    background: linear-gradient(135deg, #3a6b8f 0%, #1a3a5c 50%, #0f2a47 100%);
  }

  .hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 42, 71, 0.35) 0%,
      rgba(15, 42, 71, 0.78) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding: var(--space-10) 0 var(--space-12);
    color: var(--color-text-invert);
  }

  .hero__kicker {
    color: var(--color-text-invert);
    opacity: 0.9;
    margin-bottom: var(--space-5);
  }

  .hero__headline {
    color: var(--color-text-invert);
    font-size: clamp(2.5rem, 6vw + 1rem, var(--text-5xl));
    font-weight: var(--weight-black);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
    max-width: 18ch;
    margin-bottom: var(--space-5);
  }

  .hero__headline em {
    font-style: normal;
    border-bottom: 4px solid var(--color-text-invert);
    padding-bottom: 2px;
  }

  .hero__lede {
    color: rgba(247, 244, 238, 0.92);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 55ch;
    margin-bottom: var(--space-6);
  }

  .hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: var(--space-3) var(--space-6);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 2px solid transparent;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .hero__cta--primary {
    background: var(--color-bg);
    color: var(--color-primary);
  }

  .hero__cta--primary:hover,
  .hero__cta--primary:focus-visible {
    background: var(--color-surface);
  }

  .hero__cta--ghost {
    background: transparent;
    color: var(--color-text-invert);
    border-color: rgba(247, 244, 238, 0.5);
  }

  .hero__cta--ghost:hover,
  .hero__cta--ghost:focus-visible {
    background: rgba(247, 244, 238, 0.12);
    border-color: var(--color-text-invert);
  }

  /* Reverse focus ring on the dark hero */
  .hero__cta:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-invert);
    outline-offset: var(--focus-ring-offset);
    box-shadow: 0 0 0 calc(var(--focus-ring-width) + var(--focus-ring-offset) + 2px)
      var(--color-primary);
  }

  @media (min-width: 700px) {
    .hero__inner {
      padding: var(--space-12) 0 var(--space-16);
    }
  }
</style>
