---
import BaseLayout from './BaseLayout.astro';
import Nav from '@/components/ui/Nav.astro';
import Footer from '@/components/ui/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const publicLinks = [
  { label: 'Området', href: '/omradet' },
  { label: 'Vad ingår', href: '/vad-ingar' },
  { label: 'Frågor & svar', href: '/fragor-och-svar' },
  { label: 'Dokument', href: '/dokument' },
  { label: 'Avgifter', href: '/avgifter' },
  { label: 'Styrelsen', href: '/styrelsen' },
  { label: 'Kontakt', href: '/kontakt' },
];
---

<BaseLayout title={title} description={description}>
  <Nav links={publicLinks} />
  <main id="main">
    <slot />
  </main>
  <Footer />
</BaseLayout>
